rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isCoordinator() {
      return isVerified() && request.auth.token.email == 'profesunlp@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidAlumno(data) {
      return data.keys().hasAll(['nombre', 'dni', 'disciplina', 'nivel']) &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.dni is string && data.dni.size() <= 20 &&
             data.disciplina is string &&
             data.nivel is string &&
             (!('userId' in data) || data.userId == request.auth.uid) &&
             (data.keys().size() >= 4 && data.keys().size() <= 35); // Prevent shadow fields
    }

    function isValidClase(data) {
      return data.keys().hasAll(['fecha', 'grupo', 'entrenador']) &&
             data.fecha is string && data.grupo is string && data.entrenador is string &&
             (data.keys().size() >= 3 && data.keys().size() <= 20);
    }

    function isValidAsistencia(data) {
      return data.keys().hasAll(['fecha', 'alumnoId', 'presente']) &&
             data.fecha is string && data.alumnoId is string && data.presente is bool &&
             (data.keys().size() >= 3 && data.keys().size() <= 10);
    }

    // --- Collections ---

    match /alumnos/{alumnoId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidAlumno(incoming());
      allow update: if isVerified() && isValidAlumno(incoming()) && (
        isCoordinator() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['grupo', 'nivel', 'estadoPago', 'habilidades', 'biometria', 'pagosMensuales', 'observacionesMedicas', 'dni', 'nombre', 'contacto', 'fechaNacimiento', 'fechaIngreso', 'fechaPrimeraClase', 'asistenciasHistoricas', 'alertas']))
      );
      allow delete: if isCoordinator();
    }

    match /clases/{claseId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidClase(incoming());
      allow update: if isVerified() && isValidClase(incoming()) && (
        isCoordinator() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['faseInicial', 'fasePrincipal', 'faseFinal', 'objetivos', 'observaciones', 'asistencias', 'fecha', 'grupo', 'entrenador', 'horario']))
      );
      allow delete: if isCoordinator();
    }

    match /asistencias/{asistenciaId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidAsistencia(incoming());
      allow update: if isVerified() && isValidAsistencia(incoming()) && (
        isCoordinator() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['presente', 'pago', 'fecha', 'alumnoId', 'grupo']))
      );
      allow delete: if isCoordinator();
    }

    match /grupos/{grupoId} {
      allow read: if isSignedIn();
      allow write: if isCoordinator();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isCoordinator();
    }

    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
      allow update: if isVerified() && (isCoordinator() || existing().author == 'Profesor');
      allow delete: if isCoordinator();
    }

    // Config and Metadata
    match /config/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /disciplinas/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /niveles/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /sources/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /habilidades/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /age_categories/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /physical_categories/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /pagos/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /warmup_options/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
    match /cooldown_options/{id} { allow read: if isSignedIn(); allow write: if isCoordinator(); }
  }
}
