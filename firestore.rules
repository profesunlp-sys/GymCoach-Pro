rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Seguridad por Defecto: Denegar todo ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers Globales ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // El Coordinador Maestro
    function isCoordinator() {
      return isVerified() && request.auth.token.email == 'profesunlp@gmail.com';
    }

    // Un usuario es Staff si es el Coordinador o si existe en la colección 'staff'
    function isStaff() {
      return isVerified() && (isCoordinator() || exists(/databases/$(database)/documents/staff/$(request.auth.uid)));
    }

    // --- Reglas por Colección ---

    // STAFF: Los profes pueden ver la lista y crear su propio perfil
    match /staff/{userId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && request.auth.uid == userId;
      allow update: if isVerified() && (isCoordinator() || request.auth.uid == userId);
      allow delete: if isCoordinator();
    }

    // ALUMNOS: Lectura para todo el staff (necesario para autocompletado global)
    match /alumnos/{alumnoId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isCoordinator();
    }

    // CLASES y ASISTENCIAS: Operativa diaria
    match /clases/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }
    
    match /asistencias/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // CONFIGURACIÓN: Solo lectura para staff, edición solo por el Coordinador
    match /grupos/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /config/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /disciplinas/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /niveles/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /habilidades/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /pagos/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /sources/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    
    // FEEDBACK
    match /feedback/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && (resource.data.uid == request.auth.uid || isCoordinator());
      allow delete: if isCoordinator();
    }

    // Categorías y otros metadatos
    match /age_categories/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /physical_categories/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /warmup_options/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /cooldown_options/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
    match /profesores/{id} { allow read: if isStaff(); allow write: if isCoordinator(); }
  }
}
