rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Función auxiliar: verificar si el usuario está autenticado ──
    function isAuth() {
      return request.auth != null;
    }

    // ── Función auxiliar: verificar si es el coordinador ──
    function isCoordinator() {
      return isAuth() && request.auth.token.email == 'profesunlp@gmail.com';
    }

    // ── Función auxiliar: verificar si es un staff (cualquier usuario logueado) ──
    function isStaff() {
      return isAuth();
    }

    // ═══════════════════════════════════════════════════
    // ALUMNOS
    // Coordinador: puede leer, crear, modificar y eliminar todo.
    // Staff/Profesores: pueden leer y crear. Solo pueden modificar
    //   nivel, grupo, habilidades y biometria.
    //   NO pueden tocar pagosMensuales ni ningún otro campo de pago.
    // ═══════════════════════════════════════════════════
    match /alumnos/{alumnoId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isCoordinator()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nivel', 'grupo', 'habilidades', 'biometria']));
      allow delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // GRUPOS — Todos los staff pueden leer
    // Solo el coordinador puede crear/editar/eliminar
    // ═══════════════════════════════════════════════════
    match /grupos/{grupoId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // ASISTENCIAS — Todos los staff pueden leer y escribir
    // ═══════════════════════════════════════════════════
    match /asistencias/{asistenciaId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // HABILIDADES — Todos los staff pueden leer y escribir
    // ═══════════════════════════════════════════════════
    match /habilidades/{habilidadId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // STAFF / PROFESORES — Todos leen, solo coordinador escribe
    // ═══════════════════════════════════════════════════
    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /profesores/{profesorId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // CLASES — Todos los staff pueden leer y escribir
    // ═══════════════════════════════════════════════════
    match /clases/{claseId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // CONFIGURACIÓN — Listas dinámicas (niveles, disciplinas, etc.)
    // Todos leen, solo coordinador modifica
    // ═══════════════════════════════════════════════════
    match /niveles/{nivelId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /disciplinas/{disciplinaId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /warmup_options/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /cooldown_options/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /age_categories/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    match /physical_categories/{itemId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // FUENTES / KNOWLEDGE BASE — Solo el coordinador
    // ═══════════════════════════════════════════════════
    match /sources/{sourceId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    // ═══════════════════════════════════════════════════
    // CUALQUIER OTRA COLECCIÓN — Denegado por defecto
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
