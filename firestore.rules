rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'profesunlp@gmail.com' || 
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Alumnos ---
    match /alumnos/{alumnoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAlumno(incoming());
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isValidAlumno(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['habilidades', 'biometria', 'estadoPago', 'asistenciasHistoricas', 'pagosMensuales', 'qrCode']))
      );
      allow delete: if isAdmin();

      function isValidAlumno(data) {
        return data.keys().hasAll(['nombre', 'dni', 'disciplina', 'nivel']) &&
               data.nombre is string && data.nombre.size() <= 100 &&
               data.dni is string && data.dni.size() <= 20 &&
               data.disciplina is string &&
               data.nivel is string;
      }
    }

    // --- Clases ---
    match /clases/{claseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidClase(incoming());
      allow update: if isSignedIn() && isValidClase(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['asistencias', 'objetivos', 'faseInicial', 'fasePrincipal', 'faseFinal'])
      );
      allow delete: if isAdmin();

      function isValidClase(data) {
        return data.keys().hasAll(['fecha', 'grupo']) &&
               data.fecha is string &&
               data.grupo is string;
      }
    }

    // --- Asistencias ---
    match /asistencias/{asistenciaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAsistencia(incoming());
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isAdmin();

      function isValidAsistencia(data) {
        return data.keys().hasAll(['fecha', 'alumnoId', 'grupo', 'presente']) &&
               data.alumnoId is string && isValidId(data.alumnoId) &&
               data.presente is bool;
      }
    }

    // --- Config & Categories & Sources ---
    // These are semi-static or admin managed
    match /disciplinas/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /niveles/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /grupos/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isSignedIn(); } // Coaches can manage groups
    match /config/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /sources/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /staff/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /habilidades/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /warmup_options/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /cooldown_options/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /age_categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /physical_categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /pagos/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /profesores/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    
    // Feedback
    match /feedback/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().author == request.auth.token.email;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().author == request.auth.token.email);
    }
  }
}
